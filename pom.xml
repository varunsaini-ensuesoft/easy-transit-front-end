<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>com.hentech.easytransit</groupId>
	<artifactId>siteweb-admin-frontend</artifactId>
	<version>1.7.0-SNAPSHOT</version>
	<name>siteweb-admin-frontend</name>
	<description>Projet frontend du Back-Office de EasyTransit</description>
	<properties>
		<npm.node.version>v20.19.1</npm.node.version>
		<npm.npm.version>10.2.4</npm.npm.version>
		<node.internal.repo>http://5.196.249.203:8082/nexus/content/repositories/nodejs_org/</node.internal.repo>
		<npm.internal.registry>http://5.196.249.203:8082/nexus/content/groups/central-npm-all/</npm.internal.registry>
		<!--<npm.install.dir>${project.build.directory}</npm.install.dir>-->
		<npm.install.dir>${project.basedir}</npm.install.dir>
		<npm.working.dir>${project.basedir}</npm.working.dir>
	</properties>
	<build /> 
	<profiles>
		<profile>
			<id>hudson-spice</id>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-assembly-plugin</artifactId>
						<version>2.6</version>
						<configuration>
							<descriptors>
								<descriptor>descriptors/static-web-resources-compiled.xml</descriptor>
							</descriptors>
						</configuration>
						<executions>
							<execution>
								<id>packaging-static-web-resources-compiled</id>
								<phase>package</phase>
								<goals>
									<goal>attached</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<artifactId>maven-clean-plugin</artifactId>
						<version>3.1.0</version>
						<configuration>
							<fileSets>
								<fileSet>
									<directory>${basedir}</directory>
									<includes>
										<include>build/**/*</include>
									</includes>
								</fileSet>
							</fileSets>
						</configuration>
					</plugin>
					<plugin>
						<groupId>com.github.eirslett</groupId>
						<artifactId>frontend-maven-plugin</artifactId>
						<version>1.9.1</version>
						<configuration>
							<nodeVersion>${npm.node.version}</nodeVersion>
							<npmVersion>${npm.npm.version}</npmVersion>
							<installDirectory>${npm.install.dir}</installDirectory>
							<workingDirectory>${npm.working.dir}</workingDirectory>
							<nodeDownloadRoot>${node.internal.repo}</nodeDownloadRoot>
							<npmDownloadRoot>${npm.internal.registry}/npm/-/</npmDownloadRoot>
						</configuration>
						<executions>
							<execution>
								<id>install node and npm</id>
								<goals>
									<goal>install-node-and-npm</goal>
								</goals>
								<phase>initialize</phase>
							</execution>
							<execution>
								<id>npm config list</id>
								<goals>
									<goal>npm</goal>
								</goals>
								<phase>generate-resources</phase>
								<configuration>
									<arguments>config list</arguments>
								</configuration>
							</execution>
							<execution>
								<id>npm install</id>
								<goals>
									<goal>npm</goal>
								</goals>
								<phase>generate-resources</phase>
								<configuration>
									<arguments>install --globalconfig ${global_npm_settings}</arguments>
								</configuration>
							</execution>
							<execution>
								<id>npm run build</id>
								<goals>
									<goal>npm</goal>
								</goals>
								<phase>compile</phase>
								<configuration>
									<arguments>run-script build</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
		</profile>
		<profile>
			<id>release-npm</id>
			<activation>
				<property>
					<name>npm.publish</name>
					<value>true</value>
				</property>
			</activation>
			<build>
				<plugins>
                    <plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-assembly-plugin</artifactId>
						<version>2.6</version>
						<configuration>
							<descriptors>
								<descriptor>descriptors/static-web-resources-compiled.xml</descriptor>
							</descriptors>
						</configuration>
						<executions>
							<execution>
								<id>packaging-static-web-resources-compiled</id>
								<phase>package</phase>
								<goals>
									<goal>attached</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<artifactId>maven-clean-plugin</artifactId>
						<version>3.1.0</version>
						<configuration>
							<fileSets>
								<fileSet>
									<directory>${basedir}</directory>
									<includes>
										<include>build/**/*</include>
									</includes>
								</fileSet>
							</fileSets>
						</configuration>
					</plugin>
					<plugin>
						<groupId>com.github.eirslett</groupId>
						<artifactId>frontend-maven-plugin</artifactId>
						<version>1.9.1</version>
						<configuration>
							<nodeVersion>${npm.node.version}</nodeVersion>
							<npmVersion>${npm.npm.version}</npmVersion>
							<installDirectory>${npm.install.dir}</installDirectory>
							<workingDirectory>${npm.working.dir}</workingDirectory>
							<nodeDownloadRoot>${node.internal.repo}</nodeDownloadRoot>
							<npmDownloadRoot>${npm.internal.registry}/npm/-/</npmDownloadRoot>
						</configuration>
						<executions>
                            <execution>
								<id>install node and npm</id>
								<goals>
									<goal>install-node-and-npm</goal>
								</goals>
								<phase>initialize</phase>
							</execution>
							<execution>
								<id>npm config list</id>
								<goals>
									<goal>npm</goal>
								</goals>
								<phase>generate-resources</phase>
								<configuration>
									<arguments>config list</arguments>
								</configuration>
							</execution>
							<execution>
								<id>npm install</id>
								<goals>
									<goal>npm</goal>
								</goals>
								<phase>generate-resources</phase>
								<configuration>
									<arguments>install --globalconfig npm_g_config</arguments>
								</configuration>
							</execution>
							<execution>
								<id>npm run build</id>
								<goals>
									<goal>npm</goal>
								</goals>
								<phase>compile</phase>
								<configuration>
									<arguments>run-script build</arguments>
								</configuration>
							</execution>
						</executions>
					</plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-release-plugin</artifactId>
                        <version>3.0.0-M4</version>
						 <configuration>
    					    <checkModificationExcludes>
    					        <checkModificationExclude>src/config.js</checkModificationExclude>
    					    </checkModificationExcludes>
    					</configuration>
                    </plugin>
				</plugins>
			</build>
		</profile>
	</profiles>
	<distributionManagement>
		<repository>
			<id>hentech-deploy-release</id>
			<url>${repo-deploy-release}</url>
		</repository>
		<snapshotRepository>
			<id>hentech-deploy-snapshot</id>
			<url>${repo-deploy-snapshot}</url>
		</snapshotRepository>
	</distributionManagement>
	<scm>
		<connection>scm:git:https://github.com/zemdem/EasyTransit_Admin_Frontend</connection>
		<developerConnection>scm:git:https://github.com/zemdem/EasyTransit_Admin_Frontend</developerConnection>
		<url>https://github.com/zemdem/EasyTransit_Admin_Frontend</url>
		<tag>siteweb-admin-frontend-1.7.0</tag>
	</scm>
</project>
